# ───────── dữ liệu và đầu ra: không vào git ─────────
# Neo GỐC bằng dấu `/` đầu: pattern trần `submission/` khớp cả `src/submission/`
# và từng nuốt mất `coverage.py` — file mà đường chạy CẦN.
/data/
/submission/
artifacts/**/*.npy
*.zip
*.pdf

# Ngoại lệ: ĐÚNG ba file ground truth mà README dẫn số. Thiếu chúng thì không
# kiểm lại được bất kỳ con số nào. Phần còn lại của data/eval là ảnh ablation OCR
# và log chạy cũ — 16 MB, không thuộc đường chạy.
!/data/
/data/*
!/data/eval/
/data/eval/*
!/data/eval/textual_kis_gt.json
!/data/eval/trake_gt.json
!/data/eval/colour_probe.json
*.mp4
*.webp

# ───────── build output, dựng lại được ─────────
soi_khung.html
dante_trake.html
mau_va_vat.html
khe_keyframe.html

# ───────── môi trường ─────────
.venv/
venv/
__pycache__/
*.py[cod]
.DS_Store
.modal/

# ───────── KHÔNG lên repo: test và logic ngoài đường chạy ─────────
# Repo này chỉ mang thứ THẬT SỰ VẬN HÀNH. Đường chạy `scripts/run.py` truy vết
# import ra đúng 11 file; nhóm `scripts/embed/` giữ lại vì thiếu nó thì không
# dựng lại được chỉ mục. Mọi thứ dưới đây nằm ngoài hai nhóm đó.
tests/*
# RUNBOOK bước 0 — bước kiểm TRƯỚC NGÀY THI — bảo `git pull && pytest tests/`. Với `tests/`
# bị loại hoàn toàn thì lệnh đó chạy được trên máy đang dùng (test nằm local) nhưng KHÔNG
# chạy được trên bản clone mới. Với một sự kiện "không sửa lại được" thì đó là rủi ro thật.
# Nhận đúng 14 file chỉ phụ thuộc mã ĐANG VẬN HÀNH (380 test) — giữ nguyên nguyên tắc "kho
# chỉ mang thứ thật sự vận hành". 8 file còn lại import `engine.py`, `allocator.py`,
# `frame_index.py`, `harness.py`, `*_store.py` — đều ngoài đường chạy, nên nếu nhận chúng
# thì bản clone mới sẽ ĐỎ vì thiếu module, tệ hơn là không có test.
!tests/test_bm25.py
!tests/test_coverage.py
!tests/test_dante.py
!tests/test_declarativize.py
!tests/test_jina_encoder.py
!tests/test_kbest.py
!tests/test_kis_is_trake_n1.py
!tests/test_pool.py
!tests/test_probe.py
!tests/test_rerank.py
!tests/test_rscore.py
!tests/test_score_matrix.py
!tests/test_sources.py
# Định dạng nộp bài CHÍNH THỨC — mọi lỗi ở tầng này đều CÂM, và thể lệ chỉ cho
# 3 lượt nộp mỗi gói (nộp sai định dạng vẫn tính là một lượt).
!tests/test_submission_format.py
# ⑧ Rocchio RF — lõi toán, phiên, lưu phiên, kho ảnh. Thiếu chúng thì bản clone
# mới không chạy được công cụ click, mà đó là cơ chế DUY NHẤT đã chứng minh được
# (ΔMRR +0,2557, KTC95 [+0,1680, +0,3446] trên 64 câu click được).
!tests/test_rocchio.py
!tests/test_session.py
!tests/test_store.py
!tests/test_thumbs.py
!tests/test_vector_index.py
# ⑧ Rocchio RF + đường chạy trên Modal — thuộc đường VẬN HÀNH, không phải nghiên cứu.
!scripts/rf_prepare.py
!scripts/rf_server.py
!scripts/run_thunghiem.py
!scripts/run_thunghiem_modal.py
!scripts/modal_query.py
!scripts/finalize_submission.py
scripts/search.py
scripts/asr/
scripts/ocr/
scripts/object/
scripts/calibration/
# `scripts/eval/*` chứ KHÔNG `scripts/eval/`: git không bỏ loại được file nằm trong một
# thư mục đã bị loại, nên pattern có dấu `/` cuối làm mọi dòng `!` bên dưới vô hiệu.
scripts/eval/*
!scripts/eval/encode_queries.py
!scripts/eval/score_index.py
# Ba script README dẫn tới. `score_submission.py` nằm trong bộ kiểm TRƯỚC KHI NỘP của
# RUNBOOK nên nó là file VẬN HÀNH, không phải công cụ nghiên cứu.
!scripts/eval/score_submission.py
!scripts/eval/compare_arch.py
!scripts/eval/make_queries.py
# `score_shots.py` — bộ chấm CẤP SHOT. README dẫn số của nó (R@1 cấp shot 0,56, chính là
# con số chứng minh chỗ hổng nằm ở độ phân giải thời gian chứ không ở xếp hạng), nên thiếu
# nó thì không kiểm lại được kết luận lớn nhất của dự án.
!scripts/eval/score_shots.py
src/object/
# `rscore.py` là CÔNG THỨC CHẤM nguyên văn thể lệ — ba script eval import nó, và thiếu
# nó thì không kiểm được bài nộp trước khi gửi.
src/scoring/*
!src/scoring/__init__.py
!src/scoring/rscore.py
src/ingestion/frame_index.py
src/ingestion/keyframe_store.py
src/ingestion/ocr_store.py
src/ingestion/transcript_store.py
src/retrieval/engine.py
src/submission/allocator.py
# `writer.py` KHÔNG còn ở đây: `validate_all` là bộ kiểm định dạng bài nộp, dùng trong
# RUNBOOK trước khi gửi. Nó từng bắt 266/10.000 dòng trùng và lỗi frame_id vượt độ dài.
# `kbest.py` KHÔNG còn ở đây: ⑦ đã hợp nhất KIS và TRAKE về `k_best_alignments`,
# nên `run.py` import nó — bỏ sót là repo tải về không chạy. Đúng loại lỗi mà
# `coverage.py` và `shard_plan.py` từng dính.
# bộ 100 truy vấn gán nhãn tay — do người khác export, chờ quyết định đưa vào
export_for_fusion/
bench100.html
artifacts/bench100_thumbs.json
queries_bench/
submission_bench/

# build output của `build_bench_artifact.py`; consumer `bench100.html` đã bị loại
artifacts/bench100_*.json

# ───────── đầu ra và dữ liệu vào của các lượt đo ─────────
# Bài nộp dựng lại được bằng `scripts/run.py`; bộ truy vấn dựng lại được từ ground truth.
submission_*/
queries_*/
# đầu ra của mô hình khác, đưa vào để so — không thuộc kho này
results.jsonl

# GROUND TRUTH GT v2: giữ đúng ba file mà README dẫn số, bỏ phần rà soát nội bộ.
# Cùng lý lẽ với `data/eval/*.json` ở trên — thiếu chúng thì không kiểm lại được bảng nào.
benchmark_ground_truth_final_v2/*
!benchmark_ground_truth_final_v2/README.md
!benchmark_ground_truth_final_v2/ground_truth_final.jsonl
!benchmark_ground_truth_final_v2/_gt_frame.json

# ───────── QAFuse: nghiên cứu dung hợp (E0–E4) ─────────
# `scripts/research/*` là công cụ THÍ NGHIỆM, không nằm trên đường chạy thi. Nhận đúng
# hai file mà README dẫn số: `run_e1_e4_recheck.py` (bảng E1–E3 sau khi sửa lỗi ASR) và
# `run_e4_wrrf.py` (tune hai tầng, kết luận NO-GO). Thiếu chúng thì không kiểm lại được
# bất kỳ con số nào trong mục QAFuse của README.
scripts/research/*
!scripts/research/run_e1_e4_recheck.py
!scripts/research/run_e4_wrrf.py
# Bộ eval 299 đề sinh sẵn (KIS 199 · QA 50 · TRAKE 50) trên chỉ mục 609.476 khung.
# Mã hoá truy vấn TẠI MÁY có ghim revision, không cần Modal — nên chạy lại được
# ở bản clone mới mà không tốn GPU thuê.
!scripts/research/eval_query_sets.py

# KẾT QUẢ nghiên cứu thì GIỮ — chúng là bằng chứng, không dựng lại được miễn phí.
!data/research/
!data/research/**
# …NHƯNG không giữ BẢN ĐỆM. `!data/research/**` từng kéo `trake_S.npz` 467 MB vào
# kho. Nó là ma trận điểm lưu lại để quét λ chạy trong vài giây thay vì 25 phút —
# dựng lại được miễn phí bằng `sweep_lambda_trake.py`, nên nó là bộ đệm chứ không
# phải bằng chứng.
data/research/*.npz
data/research/**/*.npz
# Bài nộp SINH RA khi eval: 299 CSV + zip, dựng lại miễn phí bằng chính script eval.
# Giữ `metrics.json` — đó mới là bằng chứng.
data/research/**/submission/
data/research/**/submission.zip

